+// The active callback is scoped to this scheduler invocation/thread. Nested
+// callbacks restore their caller's context on every return, including abort.
+struct ggml_backend_eval_context {
+    ggml_backend_t backend;
+    bool * abort;
+};
+static thread_local ggml_backend_eval_context ggml_backend_active_eval = { nullptr, nullptr };
+
+struct ggml_backend_eval_scope {
+    ggml_backend_eval_context previous;
+    bool aborted = false;
+    explicit ggml_backend_eval_scope(ggml_backend_t backend) : previous(ggml_backend_active_eval) {
+        ggml_backend_active_eval = { backend, &aborted };
+    }
+    ~ggml_backend_eval_scope() { ggml_backend_active_eval = previous; }
+};
+
+ggml_backend_t ggml_backend_sched_current_eval_backend(void) {
+    return ggml_backend_active_eval.backend;
+}
+
+void ggml_backend_sched_abort_current_eval(void) {
+    if (ggml_backend_active_eval.abort) {
+        *ggml_backend_active_eval.abort = true;
+    }
+}
