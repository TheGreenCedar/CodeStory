+#pragma once
+
+#include "ggml-backend.h"
+
+// Complete offload includes the input weights. Use the actual first layer's
+// device, so a zero-share device in a split cannot silently own the input.
+// Partial offload keeps the upstream CPU input policy.
+inline ggml_backend_dev_t llama_model_input_layer_device(
+        ggml_backend_dev_t cpu, ggml_backend_dev_t first_layer_device,
+        int n_gpu_layers, int n_layer_all) {
+    return first_layer_device && n_gpu_layers > n_layer_all ? first_layer_device : cpu;
+}
