      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "positive_request_count": {
      "const": 120,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "positive_step_count": {
      "const": 312,
