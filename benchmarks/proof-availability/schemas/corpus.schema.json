          "type": "string"
        },
        "path_length_distribution": {
          "items": {
            "$ref": "#/$defs/LengthDistributionEntryV1"
          },
          "type": "array"
        },
        "positive_step_count": {
          "const": 78,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "repository",
        "commit",
        "workspace",
        "path_file",
        "path_file_sha256",
        "source_tree_sha256",
        "path_count",
        "positive_step_count",
        "path_length_distribution"
      ],
      "type": "object"
    },
    "LengthDistributionEntryV1": {
      "additionalProperties": false,
      "properties": {
        "path_count": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "path_length": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path_length",
        "path_count"
      ],
      "type": "object"
    }
