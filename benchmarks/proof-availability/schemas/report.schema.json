  "$id": "codestory.proof-availability-report/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseReportV1"
      },
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ActivationDecisionV1"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentReportV1"
    },
    "failure_funnel": {
      "$ref": "#/$defs/FailureFunnelReportV1"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/InventoryReportV1"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceV1"
    },
    "qualification_id": {
      "type": "string"
    },
    "schema": {
      "const": "codestory.proof-availability-report/v1",
      "type": "string"
    },
    "trails": {
      "items": {
        "$ref": "#/$defs/TrailReportV1"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "qualification_id",
    "provenance",
    "environment",
    "inventory",
    "trails",
    "cases",
    "failure_funnel",
    "decision"
  ],
  "title": "QualificationSummaryV1",
  "type": "object"
}
