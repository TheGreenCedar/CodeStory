{
  "$defs": {
    "ActivationDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "automatic_thresholds_met": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "failed_gates": {
          "items": {
            "$ref": "#/$defs/FailedGateV1"
          },
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/ActivationOutcomeV1"
        }
      },
      "required": [
        "outcome",
        "failed_gates"
      ],
      "type": "object"
    },
    "ActivationOutcomeV1": {
      "enum": [
        "public_exact_verifier",
        "experimental_manual_verifier",
        "keep_proof_dark",
        "delay_full_v3_cut"
      ],
      "type": "string"
    },
    "CandidateFailureHistogramV1": {
      "additionalProperties": false,
      "properties": {
        "edge_ids": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/CandidateFailureV1"
        }
      },
      "required": [
        "reason",
        "edge_ids"
      ],
      "type": "object"
    },
    "CandidateFailureV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "raw_admission",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/RawAdmissionFailureV1"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "containment",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/ContainmentFailureV1"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_binding",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/SourceBindingFailureV1"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "CandidateGateV1": {
      "enum": [
        "raw_admission",
        "containment",
        "source_binding",
        "line"
      ],
      "type": "string"
    },
    "CaseReportV1": {
      "additionalProperties": false,
      "properties": {
        "actionable_exact_gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypedGapV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempted_step_count": {
          "format": "uint8",
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "authoritative_receipt_count": {
          "format": "uint64",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "authoritative_receipt_evidence_count": {
          "format": "uint64",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "case_id": {
          "type": "string"
        },
        "complete_projection_bytes": {
          "format": "uint64",
          "maximum": 65536,
          "minimum": 0,
          "type": "integer"
        },
        "diagnostic_candidate_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "negative_mutations": {
          "items": {
            "$ref": "#/$defs/NegativeMutationResultV1"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "oracle_receipts_exact": {
          "type": "boolean"
        },
        "product_disposition": {
          "$ref": "#/$defs/ProductDispositionV1"
        },
        "proof_trace": {
          "$ref": "#/$defs/ProofQualificationTraceV1"
        },
        "proven_prefix_length": {
          "format": "uint8",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "proven_step_precision_milli": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "proven_step_recall_milli": {
          "format": "uint16",
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "receipt_comparisons": {
          "items": {
            "$ref": "#/$defs/ReceiptComparisonV1"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "repository_id": {
          "type": "string"
        },
        "stage_durations_ms": {
          "$ref": "#/$defs/StageDurationsV1"
        },
        "transport": {
          "$ref": "#/$defs/TransportEvidenceV1"
        },
        "unclassified_step_indices": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 6,
          "minItems": 0,
          "type": "array"
        },
        "warm_end_to_end_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "repository_id",
        "product_disposition",
        "authoritative_receipt_count",
        "oracle_receipts_exact",
        "proven_step_precision_milli",
        "proven_step_recall_milli",
        "proven_prefix_length",
        "diagnostic_candidate_count",
        "authoritative_receipt_evidence_count",
        "warm_end_to_end_ms",
        "stage_durations_ms",
        "attempted_step_count",
        "unclassified_step_indices",
        "receipt_comparisons",
        "complete_projection_bytes",
        "transport",
        "negative_mutations",
        "proof_trace"
      ],
      "type": "object"
    },
    "ContainmentFailureV1": {
      "enum": [
        "edge_source_file_mismatch",
        "missing",
        "ambiguous"
      ],
      "type": "string"
    },
    "EnvironmentReportV1": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "environment_id": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/ProjectMaterializationEvidenceV1"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "rust_host": {
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "os",
        "architecture",
        "rust_host",
        "binary_sha256",
        "projects"
      ],
      "type": "object"
    },
    "FailedGateV1": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/GateFailureDetailV1"
        },
        "gate_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QualificationGateKindV1"
        }
      },
      "required": [
        "gate_id",
        "kind",
        "detail"
      ],
      "type": "object"
    },
    "FailureBucketV1": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/FunnelOutcomeV1"
        }
      },
      "required": [
        "outcome",
        "count"
      ],
      "type": "object"
    },
    "FailureFunnelReportV1": {
      "additionalProperties": false,
      "properties": {
        "attempted_positive_steps": {
          "const": 312,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/FailureBucketV1"
          },
          "maxItems": 312,
          "minItems": 1,
          "type": "array"
        },
        "classified_positive_steps": {
          "format": "uint16",
          "maximum": 312,
          "minimum": 0,
          "type": "integer"
        },
        "unclassified_positive_steps": {
          "format": "uint16",
          "maximum": 312,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "attempted_positive_steps",
        "classified_positive_steps",
        "unclassified_positive_steps",
        "buckets"
      ],
      "type": "object"
    },
    "FinalizationFailureV1": {
      "enum": [
        "receipt_integration",
        "receipt_budget",
        "projection_budget"
      ],
      "type": "string"
    },
    "FinalizationTraceV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "not_run",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "complete",
              "type": "string"
            },
            "projection_bytes": {
              "format": "uint64",
              "maximum": 65536,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "projection_bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "failure": {
              "$ref": "#/$defs/FinalizationFailureV1"
            },
            "kind": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "failure"
          ],
          "type": "object"
        }
      ]
    },
    "FunnelOutcomeV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "admitted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gate": {
              "$ref": "#/$defs/CandidateGateV1"
            },
            "histogram": {
              "items": {
                "$ref": "#/$defs/CandidateFailureHistogramV1"
              },
              "type": "array"
            },
            "kind": {
              "const": "first_zero_survivor",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "gate",
            "histogram"
          ],
          "type": "object"
        }
      ]
    },
    "GateFailureDetailV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "count",
              "type": "string"
            },
            "observed": {
              "type": "string"
            },
            "required": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "observed",
            "required"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cohort",
              "type": "string"
            },
            "observed": {
              "type": "string"
            },
            "repository_id": {
              "type": "string"
            },
            "required": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "repository_id",
            "observed",
            "required"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/TransportEvidenceV1"
            },
            "kind": {
              "const": "transport",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/SourceDependencyEvidenceV1"
            },
            "kind": {
              "const": "source_dependency",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence"
          ],
          "type": "object"
        }
      ]
    },
    "IntegrationDependencyTestKindV1": {
      "enum": [
        "packet_v3_requires_proof",
        "transport_cannot_represent_keep_dark"
      ],
      "type": "string"
    },
    "IntegrationDependencyTestStatusV1": {
      "enum": [
        "passed"
      ],
      "type": "string"
    },
    "IntegrationDependencyTestV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/IntegrationDependencyTestKindV1"
        },
        "status": {
          "$ref": "#/$defs/IntegrationDependencyTestStatusV1"
        },
        "test_id": {
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "kind",
        "status"
      ],
      "type": "object"
    },
    "InventoryReportV1": {
      "additionalProperties": false,
      "properties": {
        "admitted_rows": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "effective_endpoint_rows": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "exact_resolved_rows": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "repository_id": {
          "type": "string"
        },
        "stored_call_rows": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "unresolved_placeholder_rows": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "stored_call_rows",
        "effective_endpoint_rows",
        "exact_resolved_rows",
        "admitted_rows",
        "unresolved_placeholder_rows"
      ],
      "type": "object"
    },
    "MaterializationFreshnessV1": {
      "enum": [
        "fresh",
        "stale",
        "missing"
      ],
      "type": "string"
    },
    "McpRevisionV1": {
      "enum": [
        "2024-11-05",
        "2025-03-26",
        "2025-06-18",
        "2025-11-25"
      ],
      "type": "string"
    },
    "NegativeMutationKindV1": {
      "enum": [
        "remove_expected_relation",
        "add_ambiguous_relation"
      ],
      "type": "string"
    },
    "NegativeMutationResultV1": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "type": "string"
        },
        "contract_proven": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/NegativeMutationKindV1"
        },
        "mutation_id": {
          "type": "string"
        },
        "path_id": {
          "type": "string"
        },
        "step_index": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "mutation_id",
        "path_id",
        "kind",
        "step_index",
        "caller",
        "target",
        "contract_proven"
      ],
      "type": "object"
    },
    "OracleSourceRangeV1": {
      "additionalProperties": false,
      "properties": {
        "end_byte": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "file_byte_length": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "start_byte": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_byte",
        "end_byte",
        "file_byte_length",
        "sha256"
      ],
      "type": "object"
    },
    "ProductDispositionKindV1": {
      "enum": [
        "contract_proven",
        "unknown",
        "certified_absence",
        "invalid"
      ],
      "type": "string"
    },
    "ProductDispositionV1": {
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "items": {
            "$ref": "#/$defs/TypedGapV1"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ProductDispositionKindV1"
        }
      },
      "required": [
        "kind",
        "gaps"
      ],
      "type": "object"
    },
    "ProjectMaterializationEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "core_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "core_run_id": {
          "type": "string"
        },
        "database_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "edge_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "file_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "freshness": {
          "$ref": "#/$defs/MaterializationFreshnessV1"
        },
        "node_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repository_id": {
          "type": "string"
        },
        "source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "source_tree": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "store_schema": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "source_head",
        "source_tree",
        "store_schema",
        "file_count",
        "node_count",
        "edge_count",
        "freshness",
        "database_sha256",
        "core_generation",
        "core_run_id"
      ],
      "type": "object"
    },
    "ProofQualificationTraceV1": {
      "additionalProperties": false,
      "properties": {
        "finalization": {
          "$ref": "#/$defs/FinalizationTraceV1"
        },
        "selector_early_return": {
          "type": "boolean"
        },
        "selectors": {
          "items": {
            "$ref": "#/$defs/SelectorQualificationTraceV1"
          },
          "maxItems": 7,
          "minItems": 2,
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepQualificationTraceV1"
          },
          "maxItems": 6,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "selectors",
        "selector_early_return",
        "steps",
        "finalization"
      ],
      "type": "object"
    },
    "ProvenanceV1": {
      "additionalProperties": false,
      "properties": {
        "binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "results_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "source_tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "thresholds_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "source_commit",
        "source_tree",
        "binary_sha256",
        "corpus_sha256",
        "thresholds_sha256",
        "results_sha256"
      ],
      "type": "object"
    },
    "QualificationGateKindV1": {
      "enum": [
        "false_contract_proven",
        "receipt_mismatch",
        "certified_absence",
        "failure_funnel",
        "provenance",
        "response_size",
        "cohort_failure",
        "product_disposition_mismatch",
        "automatic_threshold",
        "stable_threshold",
        "experimental_usefulness",
        "integration_dependency"
      ],
      "type": "string"
    },
    "RawAdmissionFailureV1": {
      "enum": [
        "wrong_kind",
        "certainty_absent",
        "certainty_probable",
        "certainty_uncertain",
        "wrong_effective_source",
        "wrong_effective_target",
        "missing_exact_resolved_target",
        "candidate_alternatives_retained",
        "missing_file_node",
        "missing_line",
        "invalid_or_legacy_callsite_identity",
        "callsite_file_mismatch",
        "callsite_line_mismatch",
        "callsite_raw_target_mismatch"
      ],
      "type": "string"
    },
    "ReceiptComparisonV1": {
      "additionalProperties": false,
      "properties": {
        "caller": {
          "type": "string"
        },
        "callsite_id": {
          "type": "string"
        },
        "edge_id": {
          "format": "int64",
          "type": "integer"
        },
        "exact_line": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "exact_window": {
          "$ref": "#/$defs/OracleSourceRangeV1"
        },
        "oracle_step_index": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "result": {
          "$ref": "#/$defs/ReceiptMatchResultV1"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "oracle_step_index",
        "caller",
        "edge_id",
        "callsite_id",
        "exact_line",
        "exact_window",
        "target",
        "result"
      ],
      "type": "object"
    },
    "ReceiptMatchResultV1": {
      "enum": [
        "exact",
        "missing",
        "mismatched"
      ],
      "type": "string"
    },
    "SelectorFailureV1": {
      "enum": [
        "missing",
        "ambiguous",
        "non_callable"
      ],
      "type": "string"
    },
    "SelectorGateOutcomeV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resolved",
              "type": "string"
            },
            "node_id": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "node_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "failed",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/SelectorFailureV1"
