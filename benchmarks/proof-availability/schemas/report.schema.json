    "ToolResultBytesV1": {
      "additionalProperties": false,
      "properties": {
        "v2024_11_05": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "v2025_03_26": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "v2025_06_18": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "v2025_11_25": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "v2024_11_05",
        "v2025_03_26",
        "v2025_06_18",
        "v2025_11_25"
      ],
      "type": "object"
    },
    "TrailLengthCountsV1": {
      "additionalProperties": false,
      "properties": {
        "effective_endpoint": {
          "format": "uint128",
          "minimum": 0,
          "type": "integer"
        },
        "exact_resolved": {
          "format": "uint128",
          "minimum": 0,
          "type": "integer"
        },
        "length": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "strictly_admitted": {
          "format": "uint128",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "length",
        "effective_endpoint",
        "exact_resolved",
        "strictly_admitted"
      ],
      "type": "object"
    },
    "TrailReportV1": {
      "additionalProperties": false,
      "properties": {
        "lengths": {
          "items": {
            "$ref": "#/$defs/TrailLengthCountsV1"
          },
          "type": "array"
        },
        "repository_id": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "lengths"
      ],
      "type": "object"
    },
    "TypedGapV1": {
      "enum": [
        "selector_missing",
        "selector_ambiguous",
        "relation_missing",
        "recursion",
        "source_binding",
        "projection_budget"
      ],
      "type": "string"
    }
